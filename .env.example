# Required for the app and database migrations.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/pulselink

# Recommended for absolute links and OAuth callbacks.
APP_BASE_URL=http://localhost:3000

# Optional YouTube API/OAuth integrations.
YOUTUBE_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/integrations/youtube/callback

# Optional Instagram/Meta integration.
META_APP_SECRET=
META_VERIFY_TOKEN=
META_GRAPH_VERSION=v23.0
INSTAGRAM_ACCOUNT_ID=
INSTAGRAM_PAGE_ID=
INSTAGRAM_PAGE_ACCESS_TOKEN=
INSTAGRAM_PROFILE_USERNAME=

# Optional integration token encryption key; generate a unique 32-byte key for each environment.
INTEGRATION_ENCRYPTION_KEY=
ANALYTICS_SALT=
ODESLI_API_KEY=
